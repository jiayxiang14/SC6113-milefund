# JSON-RPC endpoint. Local: Anvil. Sepolia: e.g. https://ethereum-sepolia-rpc.publicnode.com
RPC_URL=http://127.0.0.1:8545

# Optional: normally read from ../deployments/<chainId>.json written by the deploy script.
# CONTRACT_ADDRESS=0x...
# START_BLOCK=0

# Blocks to stay behind the chain head when indexing (use 2-3 on Sepolia, 0 on Anvil).
CONFIRMATIONS=0
INDEX_INTERVAL=4
# Many public RPCs cap eth_getLogs ranges; lower this if you see range errors.
INDEX_CHUNK=2000
RATE_LIMIT_PER_MINUTE=30
# DATABASE_PATH=milefund.db
# EXPLORER_URL=https://sepolia.etherscan.io
